---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hi there!</div>
    <div class="text-5xl font-bold">My name is Megan Grochal 🌺</div>
    <div class="text-3xl py-3 font-bold">GIS Specialist</div>
    <div class="py-2">
      <text class="text-lg">
        Welcome to my portfolio site! A little bio about me:
        I’m a GIS Specialist based in Philadelphia that’s been in the field for four years. I've had my education in the University of Nebraska at Omaha in Geography with a concentration in GIS. I've been a Geography nerd since I was a kid and you should’ve seen my face in college finding out that you can still make maps for a living. 

        I’m using this corner of the internet to show the GIS projects I made during my career. I have experience working on housing studies, comprehensive plans, transportation studies, and zoning analysis. I'll also share some personal map projects!

        I think a lot about how people are moved by imagery. Maps are one of the strongest forms of imagery. You can get the big picture of an area by looking at maps. It feels rewarding when you creatively solve a problem and you get a beautiful map in return.

        I’m early in my career, but down the line, I would love to find the weirdest things you can do with the softwares, improve my storytelling via cartography, and not in an academic setting, but teach people about the field. 
        
        For non-GIS goals, I want to be familiar with how database administration works. I'm currently learning how to use PostgreSQL and getting familiar with Linux terminology.

        Outside of making maps, I like to do pilates, make digital illustrations, read, try out various cafes, spend hours at museums, learn languages (starting ASL!), take long walks on the internet and flower arranging. I also love spending time with my sassy yet sweet Akita named Yuna.

      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://www.linkedin.com/in/megan-grochal-349a09153/" target="_blank"> Feel free to connect!</a>
    </div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
