---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    GIS Specialist with a sharp eye for detail, strong communication skills, and a background in both customer service and data-driven projects. Experienced in working solo and staying organized in remote settings. Always up for learning new tools and systems.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Bachelors in Science Geography Major - Concentration in GIS"
      subtitle="[2019] to [2022] at [University of Nebraska at Omaha], [Omaha], [Nebraska]"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="GIS Specialist"
      subtitle="From April 2022 to July 2026 at RDG Planning & Design, Omaha, NE"
    >
      Created demographic analysis maps, site assessment visualizations, and document ready maps supporting municipal and private sector projects. Developed and maintained geospatial datasets and interactive web maps using ArcGIS Pro and ArcGIS Online for planning and analysis projects.
    </TimeLineElement>
    <TimeLineElement
      title="Team Lead"
      subtitle="From November 2017 to June 2021 at Panera Bread, Papillion, NE"
    >
      Trained and supervised new team members, maintaining high service quality. Memorized regulars' orders and built long-term rapport with customers. Handled register operations and resolved payment discrepancies.
    </TimeLineElement>
    <TimeLineElement
      title="Assistant Manager"
      subtitle="From August 2015 to November 2017 at Gamers, La Vista, NE"
    >
      Managed store listings and pricing strategy. Led cashier and intake training for new team members. Coordinated with management to meet operational goals and resolve customer issues.
    </TimeLineElement>
  </div>
  
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>ArcGIS Pro</li>
    <li>ArcGIS Online</li>
    <li>QGIS</li>
    <li>SQL</li>
    <li>Python</li>
    <li>HTML/CSS</li>
    <li>Adobe Photoshop</li>
    <li>Adobe Illustrator</li>
  </ul>
</BaseLayout>
