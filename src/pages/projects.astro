---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects Header</div>
  </div>

  <HorizontalCard
    title="North Iowa Corridor Comprehensive Plan"
    img="/post_img.webp"
    desc="Assisted on creating a series of maps to understand the current conditions for Cerro Gordo County in Iowa to help urban planners create future land use designations."
    url="https://files.municipalone.com/masoncity-ia/JointComprehensivePlan1464114925052024AM.pdf"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Columbus Housing Study"
    img="/post_img.webp"
    desc="Assisted on creating a series of maps to understand the current housing conditions for Columbus, Indiana for urban planners and stakeholders."
    url="https://www.columbus.in.gov/wp-content/uploads/2024/09/2024.09.23-Columbus-Housing-Study-FINAL-1.pdf"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Casper Parks and Recreation Master Plan"
    img="/post_img.webp"
    desc="Created a dataset showing the existing amenities within the parks of Casper, Wyoming where landscape architects can help delegate maintenance costs for stakeholders."
    url="https://www.casperwy.gov/explore/parks_and_trails/park_planning___updates.php#docaccess-muscatine%20comprehensive%20plan"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Muscatine Future Land Use Interactive Map"
    img="/post_img.webp"
    desc="Developed an interactive ArcGIS Online web map supporting long-range land use planning and stakeholder engagement."
    url="https://experience.arcgis.com/experience/96f7e71eb93f4eb19d3177cdb6d33fcf"
  />
</BaseLayout>
